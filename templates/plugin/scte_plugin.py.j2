def _type16_callback(event_payload: dict) -> None:
    """Callback for get_event_payload following Type 16 SCTE event."""
    global EXTERNAL_ID, LIVE_EVENT_DATA, LIVE_EVENT_PAYLOAD, SLICER_ID_MISMATCH

    try:
        external_id = EXTERNAL_ID[-1]
    except IndexError:
        log('[upl-py_Err] _type16_callback: EXTERNAL_ID list is empty, cannot dispatch downstream')
        return

    LIVE_EVENT_PAYLOAD[external_id] = event_payload

    events = event_payload.get('events', [])
    if not events:
        err = event_payload.get('error', 'no events returned')
        log(f'[upl-py_Err] _type16_callback: no events for external_id={external_id} err={err}')
        return

    slicer_id = SLICER_STATUS_DICT.get('slicer_id', '')
    for event in events:
        for conflict in event.get('conflicts', []):
            conflict_slicer = conflict.get('slicer_id')
            if conflict_slicer and conflict_slicer != slicer_id:
                SLICER_ID_MISMATCH = True
                log(f'[upl-py_Err] _type16_callback: slicer_id mismatch '
                    f'external_id={external_id} expected={slicer_id} '
                    f'conflict={conflict_slicer} — NOT starting event')
                return

    LIVE_EVENT_DATA = events[0]

    start_time_epoch = int(time.time() * 1000) + 1000

    terminal_event_update(external_id, start_time_epoch, _terminal_update_cb)
    pts = _TYPE16_PTS_CACHE.get('pts', 0)
    pts_offset = _TYPE16_PTS_CACHE.get('pts_offset', 0)
    start_event(external_id, slicer_id, _start_event_cb, pts, pts_offset)


def _terminal_update_cb(payload: dict) -> None:
    """Log-only callback for terminal_event_update."""
    events = payload.get('events', [])
    if not events:
        err = payload.get('error', 'no events returned')
        log(f'[upl-py_Warn] _terminal_update_cb: update failed err={err}')
    else:
        log('[upl-py_CB] _terminal_update_cb: update ok')


def _start_event_cb(live_event_id) -> None:
    """Callback for start_event — populates LIVE_EVENT_ID and defensively re-fires ContentStart."""
    global LIVE_EVENT_ID
    try:
        external_id = EXTERNAL_ID[-1]
    except IndexError:
        log('[upl-py_Err] _start_event_cb: EXTERNAL_ID list is empty')
        return

    if not live_event_id:
        log(f'[upl-py_Err] _start_event_cb: no live_event_id returned for external_id={external_id}')
        return

    LIVE_EVENT_ID[external_id] = live_event_id
    log(f'[upl-py_CBCS] _start_event_cb: LIVE_EVENT_ID[{external_id}]={live_event_id}')

    if slicer.GetState() != 'slicing':
        pts = _TYPE16_PTS_CACHE.get('pts', 0)
        pts_offset = _TYPE16_PTS_CACHE.get('pts_offset', 0)
        slicer_id = SLICER_STATUS_DICT.get('slicer_id', '')
        log(f'[upl-py_Warn] _start_event_cb: slicer state != slicing, forcing ContentStart + FlushBreakMeta')
        slicer.ContentStart(int(pts + pts_offset), f'{slicer_id} - {external_id}', external_id)
        slicer.FlushBreakMeta(int(pts + pts_offset))


# PTS cache for Type 16 async handoff.
_TYPE16_PTS_CACHE = {'pts': 0, 'pts_offset': 0}


# -----------------------------------------------------------------------------
# HandleCall dispatcher
# -----------------------------------------------------------------------------

def _dispatch_handlecall(request_id: int, response) -> None:
    """Route async API response to registered callback."""
    global HANDLECALL_REQUEST_METADATA

    metadata = HANDLECALL_REQUEST_METADATA.pop(request_id, None)
    if metadata is None:
        log(f'[upl-py_Err] _dispatch_handlecall: unrecognized request_id={request_id}')
        return

    kind = metadata.get('kind', 'unknown')
    callback = metadata.get('callback')
    if callback is None:
        log(f'[upl-py_Err] _dispatch_handlecall: no callback for request_id={request_id} kind={kind}')
        return

    parsed = None
    parse_error = None
    try:
        if isinstance(response, (dict, list)):
            parsed = response
        elif isinstance(response, (bytes, bytearray)):
            parsed = json.loads(response.decode('utf-8'))
        elif isinstance(response, str):
            parsed = json.loads(response)
        else:
            parse_error = f'unexpected response type: {type(response).__name__}'
    except Exception as e:
        parse_error = f'{e}'

    if parse_error is not None:
        log(f'[upl-py_Err] _dispatch_handlecall: parse failed for request_id={request_id} '
            f'kind={kind} err={parse_error}')
        try:
            if kind == 'start_event':
                callback(None)
            else:
                callback({'events': [], 'error': parse_error})
        except Exception as cb_e:
            log(f'[upl-py_Err] _dispatch_handlecall: failure-sentinel callback raised '
                f'kind={kind} err={cb_e}' + traceback.format_exc())
        return

    try:
        if kind == 'start_event':
            assert isinstance(parsed, dict)
            events = parsed.get('events', [])
            if not events:
                log(f'[upl-py_Err] _dispatch_handlecall: start_event returned no events request_id={request_id}')
                callback(None)
                return
            event_id = events[0].get('id')
            if not event_id:
                log(f'[upl-py_Err] _dispatch_handlecall: start_event event has no id request_id={request_id}')
                callback(None)
                return
            callback(event_id)
            log(f'[upl-py_CB] _dispatch_handlecall: kind={kind} request_id={request_id} dispatched with event_id={event_id}')
        else:
            callback(parsed)
            log(f'[upl-py_CB] _dispatch_handlecall: kind={kind} request_id={request_id} dispatched')
    except Exception as e:
        log(f'[upl-py_Err] _dispatch_handlecall: callback raised kind={kind} err={e}' + traceback.format_exc())


def le_epoch_times(pts: int) -> dict:
    """Compute Live Event epoch timestamps from a base48k uPTS value."""
    now_epoch_ms = int(time.time() * 1000)
    pts_epoch_ms = int(pts / 48.0)  # pts / 48000 * 1000
    return {'now_epoch_ms': now_epoch_ms, 'pts_epoch_ms': pts_epoch_ms}
