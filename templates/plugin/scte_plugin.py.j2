# =============================================================================
# ID3 file writer
# =============================================================================

def id3_to_file(pts: int, external_id: str, output_dir: str = '/tmp') -> str:
    """Write an ID3 tag file for Type 16 events. Returns path or '' on failure."""
    try:
        payload = {
            'external_id': external_id,
            'pts': pts,
            'epoch_ms': int(time.time() * 1000),
        }
        encoded = base64.b64encode(json.dumps(payload).encode('utf-8')).decode('ascii')
        filename = f'{external_id}_{pts}.id3'
        path = os.path.join(output_dir, filename)
        with open(path, 'w') as f:
            f.write(encoded)
        log(f'[upl-py_ID3] id3_to_file: wrote {path}')
        return path
    except Exception as e:
        log(f'[upl-py_Err] id3_to_file: {e}' + traceback.format_exc())
        return ''
