{#-
  _method_linear_type5_segids.py.j2 — LinearType5SegIds channel-group method.

  Rendered when m.preset == 'linear_type5_segids'. For operators whose
  encoder emits segmentation_descriptors on Type 5 (splice_insert)
  commands instead of the conventional Type 6 (time_signal) carriage.

  Delegates the def <name>() body to linear_method() in
  _method_linear_common.py.j2. Type 6 dispatch is identical to Standard
  Linear; command_type == 5 dispatch is provided via {% call %}.

  Type 5 dispatch selector: outofnetwork_mode (runtime, uplynk.conf).
    True/1  → OON path — reads out_of_network_indicator from the message,
              uses splice_command.duration, pts_offset_500/501. Identical
              to Standard Linear when its outofnetwork_mode is True.
    False/0 → seg-ID path — reads segmentation_descriptors from the Type 5
              command, runs the pair loop via _handle_time_signal_ad_breaks
              (descriptor-container-agnostic), uses segmentation_duration
              and pts_offset_<seg_id>. Honors ad_break_scope. Distinct from
              Standard Linear, which log-and-skips its Type 5 branch in
              this state.

  Context in scope from parent:
    m.name           (str, PascalCase)
    m.channel_group  (str, snake_case)
    m.seg_id_pairs   (list[tuple])
    m.ad_break_scope (str)
    features         (set[str])
    client_name      (str)
-#}
{% import '_method_linear_common.py.j2' as common with context %}
# =============================================================================
# {{ m.name }} — `linear_type5_segids` preset channel-group method
# =============================================================================
# Dispatch shape:
#   command_type=6 → identical to Standard Linear.
#   command_type=5 → gated by outofnetwork_mode (uplynk.conf):
#                    True  → OON-driven (Standard Linear semantics).
#                    False → descriptor-driven seg-ID dispatch via
#                            _handle_time_signal_ad_breaks against the
#                            Type 5 command's descriptors. Uses
#                            segmentation_duration and pts_offset_<seg_id>.

{% call common.linear_method(m.name) %}
# =================================================================
# command_type=5 — dispatch selector: outofnetwork_mode.
# =================================================================
if passthrough_mode:
    log(f'[upl-py_Mode] Passthrough mode set to {passthrough_mode}, '
        f'skip processing all ad breaks',
        command_type=command_type, call_sign=call_sign,
        slicer_version=slicer_version, stream_type=stream_type)
elif skip_splice:
    log(f'[upl-py_Mode] ad_skip_spliceinsert set to {skip_splice}, '
        f'skip processing splice_insert ad breaks',
        command_type=command_type, call_sign=call_sign,
        slicer_version=slicer_version, stream_type=stream_type)
elif ad_mode != 'splice_insert':
    log(f'[upl-py_Mode] ad_break_mode={ad_mode}, observing but '
        f'ignoring Type 5 splice_insert',
        command_type=command_type, call_sign=call_sign,
        stream_type=stream_type)
elif in_blackout:
    log('[upl-py_Bo] In blackout, suppressing Type 5 ad break',
        command_type=command_type, call_sign=call_sign,
        stream_type=stream_type)
elif outofnetwork_mode:
    # OON path — identical to Standard Linear.
    command = slice_info.get('command', {})
    oon = command.get('out_of_network_indicator', 0)
    duration_flag = command.get('duration_flag', 0)
    log(f'[upl-py_Meta] outofnetwork_mode=True, OON state: {oon}, '
        f'duration_flag: {duration_flag}',
        command_type=command_type, oon=oon)

    if oon == 1:
        pts_offset = pts_off_x(501)
        base64_oon1 = slice_info.get('base64')
        base64_oon1_str = str(base64_oon1, 'utf-8') if base64_oon1 else ''

        if duration_flag == 0:
            log(f'[upl-py_Ad] From OON=1, open-ended AdStart at '
                f'{pts + pts_offset} pts',
                command_type=command_type, oon=1,
                call_sign=call_sign, slicer_version=slicer_version,
                stream_type=stream_type)
            slicer.AdMeta('base64_oon1', base64_oon1_str)
            slicer.AdStart(int(pts + pts_offset))
        else:
            raw_duration = command.get('duration', 0)
            if raw_duration == 0:
                log(f'[upl-py_Err] From OON=1, duration_flag=1 but '
                    f'duration=0 — refusing AdStart(pts, 0). Skipping.',
                    command_type=command_type, oon=1,
                    call_sign=call_sign, slicer_version=slicer_version,
                    stream_type=stream_type)
            else:
                duration = break_dur_oon(slice_info)
                duration_offset = dur_off_x(501)
                log(f'[upl-py_Ad] From OON=1, AdStart at {pts + pts_offset} pts '
                    f'for {adis(duration, duration_offset)}s',
                    command_type=command_type, oon=1,
                    call_sign=call_sign, slicer_version=slicer_version,
                    stream_type=stream_type)
                slicer.AdMeta('base64_oon1', base64_oon1_str)
                slicer.AdStart(int(pts + pts_offset),
                               int(duration + duration_offset))

    elif oon == 0:
        pts_offset = pts_off_x(500)
        slicer.FlushBreakMeta(int(pts + pts_offset))
        log(f'[upl-py_Ad] OON=0 AdEnd at {pts + pts_offset} pts',
            command_type=command_type, oon=0,
            call_sign=call_sign, slicer_version=slicer_version,
            stream_type=stream_type)
        slicer.AdEnd(int(pts + pts_offset))

    else:
        log(f'[upl-py_Err] Warning: unexpected out_of_network_indicator '
            f'value: {oon}, taking no action',
            command_type=command_type, oon=oon,
            call_sign=call_sign, slicer_version=slicer_version,
            stream_type=stream_type)

else:
    # Descriptor-driven path — outofnetwork_mode=False.
    # Extract descriptors from the Type 5 command and dispatch via the
    # shared _handle_time_signal_ad_breaks helper. The helper is
    # descriptor-container-agnostic — it operates on seg_type_list and
    # descriptors regardless of whether they came from Type 5 or Type 6.
    log(f'[upl-py_Meta] outofnetwork_mode=False, entering seg-ID dispatch '
        f'on Type 5 descriptors',
        command_type=command_type, call_sign=call_sign,
        slicer_version=slicer_version, stream_type=stream_type)

    descriptors = slice_info.get('descriptors', [])
    if not descriptors:
        log(f'[upl-py_Err] outofnetwork_mode=False but Type 5 command has '
            f'no descriptors — cannot dispatch, taking no action',
            command_type=command_type, call_sign=call_sign,
            slicer_version=slicer_version, stream_type=stream_type)
    else:
        seg_type_list = []
        for descriptor in descriptors:
            if 'segmentation_type_id' in descriptor:
                seg_type_list.append(descriptor['segmentation_type_id'])

        _handle_time_signal_ad_breaks(
            slice_info, slicer_id, seg_type_list, descriptors, pts,
            call_sign=call_sign,
            slicer_version=slicer_version,
            stream_type=stream_type,
            ad_scope=ad_scope,
{% if 'boundary_handling' in features %}
            use_boundary=use_boundary,
            boundary_dur_max=boundary_dur_max,
{% endif %}
        )
{% endcall %}


{{ common.linear_helpers() }}