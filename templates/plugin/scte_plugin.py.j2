def boundary_mode(use_boundary=None):
    """Parse use_boundary + per-source names. Populates BOUNDARY_MODE dict."""
    global BOUNDARY_MODE
    if use_boundary in BOUNDARY_MODE:
        return BOUNDARY_MODE[use_boundary]
    try:
        raw = SLICER_CONFIG_DICT.get('use_boundary', False)
        value = _parse_bool_config(raw, default=False)
        BOUNDARY_MODE[use_boundary] = value
        BOUNDARY_MODE['boundary_name_oon']      = SLICER_CONFIG_DICT.get('boundary_name_oon', '-')
        BOUNDARY_MODE['boundary_name_local']    = SLICER_CONFIG_DICT.get('boundary_name_local', '-')
        BOUNDARY_MODE['boundary_name_national'] = SLICER_CONFIG_DICT.get('boundary_name_national', '-')
        return value
    except Exception as e:
        log(f'[upl-py_Err] boundary_mode: {e}' + traceback.format_exc())
        return False


def boundary_duration_max():
    """Cap duration for boundary mode. 0 = no cap."""
    global BOUNDARY_DUR_MAX
    if 'value' in BOUNDARY_DUR_MAX:
        return BOUNDARY_DUR_MAX['value']
    try:
        value = int(SLICER_CONFIG_DICT.get('boundary_duration_max', 0))
        BOUNDARY_DUR_MAX['value'] = value
        return value
    except Exception as e:
        log(f'[upl-py_Err] boundary_duration_max: {e}' + traceback.format_exc())
        return 0


def boundary_name_for(seg_id):
    """
    Resolve boundary name for a seg_id.

    Lookup order:
        1. boundary_name_<seg_id> config key
        2. Legacy boundary_name_local/_national/_oon convention
        3. f'boundary_{seg_id}' synthesized default
    """
    override = SLICER_CONFIG_DICT.get(f'boundary_name_{seg_id}')
    if override:
        return override
    if seg_id == 54:
        return BOUNDARY_MODE.get('boundary_name_local') or f'boundary_{seg_id}'
    if seg_id in (34, 48):
        return BOUNDARY_MODE.get('boundary_name_national') or f'boundary_{seg_id}'
    if seg_id == 501:  # OON=1 synthetic key
        return BOUNDARY_MODE.get('boundary_name_oon') or f'boundary_{seg_id}'
    return f'boundary_{seg_id}'
