            _handle_epg_response(origin_url, response, code, request_id)
            return int(0)
{% endif %}
        log(f'[upl-py_Err] HandleCall: no dispatcher matched request_id={request_id}')
    except Exception as e:
        slicer.SlicerLogger(
            'ERROR', f'[upl-py_Err] HandleCall dispatch: {e}' + traceback.format_exc()
        )
{% endif %}
    return int(0)


def Process35(slice_info):
    """
    Called for every SCTE-35 packet on the input stream. SCTE-104 → SCTE-35 upstream.

    Must complete within 250ms — runtime flags overruns as errors.
    """
    global SLICER_CONFIG_DICT, SLICER_STATUS_DICT, SCTE_LOG_VERBOSITY, PLUGIN_MEMORY_LOGGING
    try:
        start_time = time.time()

        # Duplicate SCTE check
        prev = SLICER_STATUS_DICT.get('scte_message', {})
        if prev and prev.get('base64') == slice_info.get('base64') and \
                prev.get('pts_time', -1) == slice_info.get('pts_time', -1):
            slicer.SlicerLogger('INFO', '[upl-py_35] Skipping duplicate SCTE')
            return int(0)

        slicer_values = slicer.GetStatus()
        config = slicer_values.get('config', {})
        channel_group = config.get('channel_group')
        slicer_id = slicer_values.get('slicerID')

        # Leak-safe summary dict — NEVER the raw slice_info bridge object
        SLICER_STATUS_DICT.update({
            'channel_group': channel_group,
            'slicer_id': slicer_id,
            'scte_message': {
                'base64': slice_info.get('base64'),
                'pts_time': slice_info.get('pts_time', -1),
                'repr': str(slice_info),
            },
        })
        slicer.SlicerLogger('INFO', f'[upl-py_Dict] SLICER_STATUS_DICT values are {SLICER_STATUS_DICT}')

        # Redacted config copy — {**config} avoids aliased mutation of runtime's dict
        SLICER_CONFIG_DICT = {**config, 'apikey': 'REDACTED'}
        slicer.SlicerLogger('INFO', f'[upl-py_Dict] SLICER_CONFIG_DICT values are {SLICER_CONFIG_DICT}')

        SCTE_LOG_VERBOSITY = _normalize_verbosity(config.get('scte_log_verbosity'), SCTE_LOG_VERBOSITY)
        PLUGIN_MEMORY_LOGGING = _parse_bool_config(
            config.get('plugin_memory_logging', PLUGIN_MEMORY_LOGGING),
            default=False,
        )

        # Memory usage sample (always compiled, runtime-toggled)
        if PLUGIN_MEMORY_LOGGING:
            rss_mb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024
            slicer.SlicerLogger(
                'INFO', f'[upl-py_Mem] slicer_id={slicer_id} max_rss_mb={rss_mb:.1f}'
            )

        # Dispatch to channel-group method
        if channel_group == 'scte_logger':
            SCTELogger(slice_info, slicer_id)
{% for m in methods %}
        elif channel_group == '{{ m.channel_group }}':
            {{ m.name }}(slice_info, slicer_id)
{% endfor %}
        else:
            slicer.SlicerLogger(
                'WARN',
                f'[upl-py_Warn] Unrecognized channel_group={channel_group}, '
                f'expected one of: scte_logger'
{% for m in methods %}
                f', {{ m.channel_group }}'
{% endfor %}
            )

        # Execution-time guard — FLOAT compare, never stringify
        ex_time = time.time() - start_time
        if ex_time >= _EXEC_TIME_BUDGET:
            slicer.SlicerLogger(
                'ERROR',
                f'[upl-py_Err] Plugin execution time exceeded {int(_EXEC_TIME_BUDGET * 1000)}ms budget. '
                f'Execution time in seconds: {ex_time}'
            )
        else:
            slicer.SlicerLogger('INFO', f'[upl-py_Time] Plugin execution time in seconds: {ex_time}')

    except Exception as e:
        slicer.SlicerLogger('ERROR', '[upl-py_Err] Exception in Process35 Method')
        slicer.SlicerLogger(
            'ERROR', f'[upl-py_Err] Exception: {e}' + traceback.format_exc()
        )

    return int(0)


