def HandleCall(origin_url=None, response=None, code=None, request_id=None):
    """
    Callback for async slicer.APICall() / slicer.WebCall() responses.

    Uses default None args to preserve compat with 0-arg HandleCall stubs.
    Returns int(0) per runtime contract.
    """
{% if has_live_event or has_oon %}
    try:
        if request_id is None:
            log('[upl-py_HC] HandleCall: request_id is None, cannot dispatch')
            return int(0)
        if code is not None and code != 200:
            log(f'[upl-py_Warn] HandleCall: non-200 code={code} '
                f'origin_url={origin_url} request_id={request_id}')
{% if has_live_event %}
