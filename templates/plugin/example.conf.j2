# =============================================================================
# Uplynk LiveSlicer configuration
# Plugin: scte_{{ plugin_name }}.py
# Client: {{ client_name }}
# Generated: {{ today }} by scte-plugin-generator v{{ generator_version }}
#
# This is a reference config. Keys are active for the presets/features you
# selected at generation time. Everything else is emitted commented-out so
# you can see the full surface area — uncomment to enable.
#
# Replace all <CHANGEME_*> placeholders before deploying.
# =============================================================================

# -----------------------------------------------------------------------------
# Slicer identity & authentication
# -----------------------------------------------------------------------------
apikey: <CHANGEME_APIKEY>
username: <CHANGEME_USERNAME>
slicerID: {{ plugin_name }}_01
description: {{ plugin_name }}_01

# -----------------------------------------------------------------------------
# API / SSL
# -----------------------------------------------------------------------------
api_port: 65009
authenticated_api_port: 65209
ssl_port: 65109
ssl_cert: /etc/uplynk/certs/<CHANGEME>-ssl-cert.pem
enable_remote_config: 1

# -----------------------------------------------------------------------------
# Input source (UDP multicast example — adjust for your ingest)
# -----------------------------------------------------------------------------
input: udp
manual_ip: <CHANGEME_SLICER_FQDN>
multicast: 239.0.0.1
meta: source_multicast=239.0.0.1
port: 1234
pids: 2001,3001,503
pids_optional: 4001

# RTP tuning (leave defaults unless you have a reason)
rtp_backlog_dur: 1.4
rtp_headers: 1
rtp_readahead_dur: 2.0

# -----------------------------------------------------------------------------
# Behavior
# -----------------------------------------------------------------------------
autoexpire_age: 720
drop_expired_breaks: on
future_break_expiration_minutes: 120
future_timecodes: off
no_signal_startup: yes
start_blackout: sticky
wallclock: 1
debugoverlay: 0
parse_XDS: no
nielsen: false

# -----------------------------------------------------------------------------
# Audio
# -----------------------------------------------------------------------------
enable_loudnorm: yes
target_loudness: -23
gain: 6.0

# Closed captions
cc1_desc: English
cc1_lang: en

# -----------------------------------------------------------------------------
# Live preview
# -----------------------------------------------------------------------------
preview: on
livepreview_with_audio: yes
livepreview_width: 320
livepreview_height: 240
livepreview_fps: 30
livepreview_bitrate: 500000

# -----------------------------------------------------------------------------
# SCTE plugin loading
# -----------------------------------------------------------------------------
scte_type: python
scte_module: /opt/uplynk/plugins/scte_{{ plugin_name }}.py
scte_python_version: 3.8
scte_log_verbosity: 2
plugin_memory_logging: false
# allow_scte_wakeup: false

# Diagnostic-only — not user-configurable; injected by the Uplynk runtime
# profile: <runtime-injected>
# signal_type: <runtime-injected>

# =============================================================================
# Channel group selection
# =============================================================================
# `channel_group` picks which method in the plugin handles this slicer's SCTE.
# Exactly one channel_group must be active per slicer config.
#
# Available in this plugin:
{% for m in methods -%}
#   - {{ m.channel_group }}  ({{ m.name }})
{% endfor -%}
# =============================================================================
{% if has_linear -%}
channel_group: {{ methods | selectattr('preset', 'equalto', 'linear') | map(attribute='channel_group') | first }}
{% elif has_live_event -%}
channel_group: {{ methods | selectattr('preset', 'equalto', 'live_event') | map(attribute='channel_group') | first }}
{% elif has_scte_logger -%}
channel_group: {{ methods | selectattr('preset', 'equalto', 'scte_logger') | map(attribute='channel_group') | first }}
{% endif %}

# -----------------------------------------------------------------------------
# Linear / LinearType5SegIds preset config
#
# Both presets share the same runtime knobs — one uplynk.conf serves whichever
# method the slicer's channel_group dispatches to.
# -----------------------------------------------------------------------------
{% if has_linear or has_linear_type5_segids %}
# outofnetwork_mode: gates Type 5 (splice_insert) dispatch. Semantics differ
# by preset — one config key, two meanings on the OFF side:
#   Standard Linear (`linear`):
#     1 → process Type 5 via OON path (out_of_network_indicator drives AdStart/AdEnd)
#     0 → log-and-skip all Type 5 messages
#   LinearType5SegIds (`linear_type5_segids`):
#     1 → process Type 5 via OON path (same as Standard Linear)
#     0 → process Type 5 via segmentation_descriptor pair loop (seg-ID dispatch),
#         reading segmentation_duration from the descriptor and honoring ad_break_scope
# Default 0 preserves the LinearType5SegIds intent (chose the preset for seg-ID
# dispatch). If this plugin has the `linear` preset selected and you want its
# Type 5 branch to fire, set this to 1 before deploying.
outofnetwork_mode: 0
local_mode: national
passthrough_mode: 0
program_start_via_scte_mode: 1
scte_ad_break_mode: splice_insert
# ad_break_scope: runtime role filter for Type 6 ad-break seg IDs.
#   provider    — honor 48/49, 52/53, 56/57 (Provider role pairs)
#   distributor — honor 50/51, 54/55, 58/59 (Distributor role pairs)
#   both        — honor all role-tagged pairs (default)
# 32/33 (Chapter) and 34/35 (Break) are outside the split and always fire
# if baked into the plugin at generation time.
ad_break_scope: {{ (methods | selectattr('preset', 'in', ['linear', 'linear_type5_segids']) | map(attribute='ad_break_scope') | list | first) or 'both' }}
ad_skip_spliceinsert: 0
ad_skip_timesignal: 0

# Program-start timing (Type 16)
pts_offset_16: 0

# Per-pair timing offsets (seconds, float) — one set per selected seg pair
{% set _seen_pairs = [] %}
{% for m in methods if m.preset in ['linear', 'linear_type5_segids'] %}
{% for pair in m.seg_id_pairs if pair[0] not in _seen_pairs %}
# {{ pair[2] }} — Type {{ pair[0] }}/{{ pair[1] }}
pts_offset_{{ pair[0] }}: 0
pts_offset_{{ pair[1] }}: 0
duration_offset_{{ pair[0] }}: 0
{% if _seen_pairs.append(pair[0]) %}{% endif %}
{% endfor %}
{% endfor %}

# splice_insert (Type 5) OON timing — 500=return-to-network, 501=out-of-network
pts_offset_500: 0
pts_offset_501: 0
duration_offset_501: 0
{% else %}
# outofnetwork_mode: 0     # 1=OON dispatch, 0=preset-dependent (see Linear section above)
# local_mode: national
# passthrough_mode: 0
# program_start_via_scte_mode: 1
# scte_ad_break_mode: splice_insert
# ad_break_scope: both
# ad_skip_spliceinsert: 0
# ad_skip_timesignal: 0
# pts_offset_16: 0
# pts_offset_34: 0
# pts_offset_35: 0
# duration_offset_34: 0
# pts_offset_48: 0
# pts_offset_49: 0
# duration_offset_48: 0
# pts_offset_54: 0
# pts_offset_55: 0
# duration_offset_54: 0
# pts_offset_500: 0
# pts_offset_501: 0
# duration_offset_501: 0
{% endif %}

# -----------------------------------------------------------------------------
# Live event preset config
# -----------------------------------------------------------------------------
{% if has_live_event %}
call_sign: <CHANGEME_CALLSIGN>
event_start_extension: 0.0
event_end_extension: 0.0
stream_type: 1

# Per-type duration offsets (seconds, float)
duration_offset_17: 0
duration_offset_54: 0
duration_offset_501: 0

# Per-type PTS offsets (seconds, float)
pts_offset_1: 0
pts_offset_16: 0
pts_offset_17: 0
pts_offset_19: 0
pts_offset_20: 0
pts_offset_54: 0
pts_offset_55: 0
pts_offset_500: 0
pts_offset_501: 0

# Fallback slate GUID if mid-event slate GUID cannot be resolved
midevent_slate_guid_fallback: <CHANGEME_SLATE_GUID>
{% else %}
# call_sign: <CHANGEME_CALLSIGN>
# event_start_extension: 0.0
# event_end_extension: 0.0
# stream_type: 1
# duration_offset_17: 0
# duration_offset_54: 0
# duration_offset_501: 0
# pts_offset_1: 0
# pts_offset_16: 0
# pts_offset_17: 0
# pts_offset_19: 0
# pts_offset_20: 0
# pts_offset_54: 0
# pts_offset_55: 0
# pts_offset_500: 0
# pts_offset_501: 0
# midevent_slate_guid_fallback: <CHANGEME_SLATE_GUID>
{% endif %}

# -----------------------------------------------------------------------------
# SCTELogger preset config
# -----------------------------------------------------------------------------
{% if has_scte_logger %}
# (scte_logger preset selected — no extra config keys required beyond channel_group)
# Increase scte_log_verbosity above if you want more detail in the slicer log.
{% else %}
# (scte_logger preset not selected — see scte_log_verbosity above for base logging)
{% endif %}

# =============================================================================
# Optional features
# =============================================================================

# -----------------------------------------------------------------------------
# Boundary handling
# -----------------------------------------------------------------------------
{% if 'boundary_handling' in features %}
boundary_handling: on
boundary_name_local: local
boundary_name_national: national
boundary_name_oon: oon
boundary_duration_max: 0
{% else %}
# boundary_handling: on
# boundary_name_local: local
# boundary_name_national: national
# boundary_name_oon: oon
# boundary_duration_max: 0
{% endif %}

# -----------------------------------------------------------------------------
# EIDR routing
# -----------------------------------------------------------------------------
{% if 'eidr_routing' in features %}
eidr_routing: on
eidr_default_channel: <CHANGEME_EIDR_DEFAULT>
{% else %}
# eidr_routing: on
# eidr_default_channel: <CHANGEME_EIDR_DEFAULT>
{% endif %}

# -----------------------------------------------------------------------------
# ID3 writing
# -----------------------------------------------------------------------------
{% if 'id3_writing' in features %}
id3_enable: 1
id3_mode: 0
{% else %}
# id3_enable: 1
# id3_mode: 0
{% endif %}

# =============================================================================
# End of config
# =============================================================================
