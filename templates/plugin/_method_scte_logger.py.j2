{# templates/plugin/_method_scte_logger.py.j2                                    #}
{# SCTELogger preset: parse-and-log-only diagnostic method for new customers.    #}
{# Takes no slicer action (no AdStart, ContentStart, APICall, Blackout, etc).    #}
{# Purpose: run against a prospective customer's SCTE feed to characterize their #}
{# workflow before implementing a production method.                             #}
{#                                                                               #}
{# Improvements over CNBC reference:                                             #}
{#   - Data-driven descriptor loop (single pass, no per-type if/elif duplication)#}
{#   - Full SCTE-35 seg-type coverage (not just CNBC's 11-type subset)           #}
{#   - Hex + decimal in every log line for grep from either direction            #}
{#   - Uses module-level log() (baseline hardening: HOST, PROC_ID, frame intro)  #}
{#   - Graceful UPID decode (try/except UnicodeDecodeError)                      #}
{#   - Unknown seg_id fallback (log as 'Unknown', don't drop silently)           #}
{#                                                                               #}
{# TODO(post-ship): consolidate _SCTE_LOGGER_TABLE with the seg-type table in    #}
{# _log_helpers.py.j2 (used by log()). Single source of truth.                   #}

# SCTE-35 segmentation_type_id table for the SCTELogger diagnostic method.
# Format: seg_id_decimal: (human_name, has_duration_field)
# 'has_duration' drives whether we call break_dur() and log the duration.
_SCTE_LOGGER_TABLE = {
    # Program lifecycle (0x00 - 0x19)
    0x00: ('Not Indicated', False),
    0x01: ('Content Identification', False),
    0x10: ('Program Start', False),
    0x11: ('Program End', False),
    0x12: ('Program Early Termination', False),
    0x13: ('Program Breakaway', False),
    0x14: ('Program Resumption', False),
    0x15: ('Program Runover Planned', False),
    0x16: ('Program Runover Unplanned', False),
    0x17: ('Program Overlap Start', False),
    0x18: ('Program Blackout Override', False),
    0x19: ('Program Start - In Progress', False),
    # Chapter/break (0x20 - 0x27)
    0x20: ('Chapter Start', False),
    0x21: ('Chapter End', False),
    0x22: ('Break Start', True),
    0x23: ('Break End', False),
    0x24: ('Opening Credit Start', False),
    0x25: ('Opening Credit End', False),
    0x26: ('Closing Credit Start', False),
    0x27: ('Closing Credit End', False),
    # Ads and placement opportunities (0x30 - 0x3F)
    0x30: ('Provider Advertisement Start', True),
    0x31: ('Provider Advertisement End', False),
    0x32: ('Distributor Advertisement Start', True),
    0x33: ('Distributor Advertisement End', False),
    0x34: ('Provider Placement Opportunity Start', True),
    0x35: ('Provider Placement Opportunity End', False),
    0x36: ('Distributor Placement Opportunity Start', True),
    0x37: ('Distributor Placement Opportunity End', False),
    0x38: ('Provider Overlay Placement Opportunity Start', True),
    0x39: ('Provider Overlay Placement Opportunity End', False),
    0x3A: ('Distributor Overlay Placement Opportunity Start', True),
    0x3B: ('Distributor Overlay Placement Opportunity End', False),
    0x3C: ('Provider Promo Start', True),
    0x3D: ('Provider Promo End', False),
    0x3E: ('Distributor Promo Start', True),
    0x3F: ('Distributor Promo End', False),
    # Unscheduled / alternate / ad block (0x40 - 0x47)
    0x40: ('Unscheduled Event Start', True),
    0x41: ('Unscheduled Event End', False),
    0x42: ('Alternate Content Opportunity Start', True),
    0x43: ('Alternate Content Opportunity End', False),
    0x44: ('Provider Ad Block Start', True),
    0x45: ('Provider Ad Block End', False),
    0x46: ('Distributor Ad Block Start', True),
    0x47: ('Distributor Ad Block End', False),
    # Network (0x50 - 0x51)
    0x50: ('Network Start', False),
    0x51: ('Network End', False),
}


def {{ m.name }}(slice_info, slicer_id):
    channel_group = '{{ m.channel_group }}'
    log(f'[upl-py_Method] In {channel_group} method for slicer: {slicer_id}')

    try:
        command_type = slice_info['splice_command_type']
        pts = slice_info['pts_time']  # already base48k uPTS

        # Command-type preamble
        if command_type == 5:
            # splice_insert — log OON indicator + top-level duration
            cmd = slice_info.get('command', {}) or {}
            oon = cmd.get('out_of_network_indicator', 0)
            if 'duration' in cmd:
                duration = break_dur_oon(slice_info)
                approx = adis(duration, 0)
                log(f'[upl-py_SCTE] Command 5 (splice_insert) | OON={oon} | '
                    f'duration={approx}s | PTS={pts}',
                    command_type=command_type, oon=oon)
            else:
                log(f'[upl-py_SCTE] Command 5 (splice_insert) | OON={oon} | '
                    f'no duration | PTS={pts}',
                    command_type=command_type, oon=oon)
        elif command_type == 6:
            log(f'[upl-py_SCTE] Command 6 (time_signal) | PTS={pts}',
                command_type=command_type)
        else:
            log(f'[upl-py_SCTE] Command {command_type} (unhandled command type) | PTS={pts}',
                command_type=command_type)
            return

        # Descriptor loop — command_type 5 and 6 both carry descriptors when present
        descriptors = slice_info.get('descriptors', []) or []
        if not descriptors:
            log(f'[upl-py_SCTE] No descriptors in command_type={command_type} | PTS={pts}',
                command_type=command_type)
            return

        for i, descriptor in enumerate(descriptors):
            seg_id = descriptor.get('segmentation_type_id')
            if seg_id is None:
                log(f'[upl-py_SCTE] descriptor[{i}] has no segmentation_type_id, skipping',
                    command_type=command_type)
                continue

            # Look up name + duration flag
            name, has_duration = _SCTE_LOGGER_TABLE.get(seg_id, ('Unknown', False))

            # Decode UPID (graceful — some seg types carry non-UTF8 payloads)
            upid_repr = '-'
            upid_bytes = descriptor.get('segmentation_upid', b'')
            if upid_bytes:
                try:
                    upid_repr = upid_bytes.decode('utf-8')
                except (UnicodeDecodeError, AttributeError):
                    # Fall back to hex representation for binary UPIDs (MPU, EIDR, etc.)
                    try:
                        upid_repr = f'0x{upid_bytes.hex()}'
                    except AttributeError:
                        upid_repr = repr(upid_bytes)

            # Extract duration if this seg type carries one
            duration_repr = '-'
            if has_duration:
                try:
                    duration_pts = break_dur(slice_info, i)
                    duration_repr = f'{adis(duration_pts, 0)}s'
                except Exception as dur_err:
                    duration_repr = f'(duration extract failed: {dur_err})'

            log(f'[upl-py_SCTE] Type {seg_id} (0x{seg_id:02X}) {name} | '
                f'UPID={upid_repr} | duration={duration_repr} | PTS={pts}',
                command_type=command_type, segmentation_type_id=seg_id)

    except Exception as e:
        log(f'[upl-py_Err] Exception in Plugin method {channel_group}: {e}' + traceback.format_exc())
