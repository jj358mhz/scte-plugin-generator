# -----------------------------------------------------------------------------
# EIDR routing helpers
# -----------------------------------------------------------------------------

def eidr_mode(eidr_upid):
    """Set EIDR bucket by UPID: CABLE_NETS | FBC | LOCAL | None."""
    global EIDR_MODE
    if eidr_upid in EIDR_LIST['CABLE_NETS']:
        EIDR_MODE = 'CABLE_NETS'
    elif eidr_upid in EIDR_LIST['FBC']:
        EIDR_MODE = 'FBC'
    elif eidr_upid in EIDR_LIST['LOCAL']:
        EIDR_MODE = 'LOCAL'
    else:
        EIDR_MODE = None
    return EIDR_MODE


def eidr_name_lookup(eidr_val):
    """Resolve EIDR UPID to network name across all buckets."""
    for bucket in ('CABLE_NETS', 'FBC', 'LOCAL'):
        if eidr_val in EIDR_LIST[bucket]:
            return EIDR_LIST[bucket][eidr_val]
    return None


def eidr_upid_lookup(slice_info):
    """Scan slice_info descriptors for '10.5239'-prefixed UPID."""
    try:
        for descriptor in slice_info.get('descriptors', []):
            upid_bytes = descriptor.get('segmentation_upid', b'')
            if not upid_bytes:
                continue
            upid = str(upid_bytes, 'UTF-8')
            if upid.startswith('10.5239'):
                return upid
    except Exception as e:
        log(f'[upl-py_Err] eidr_upid_lookup: {e}' + traceback.format_exc())
    return None
