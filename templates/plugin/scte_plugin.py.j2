def get_event_payload(external_id: str, slicer_id: str, callback: Callable) -> None:
    """Async fetch of Live Event payload. Failure sentinel: {'events': [], 'error': msg}."""
    global HANDLECALL_REQUEST_METADATA
    try:
        params = {'external_id': external_id, 'slicer_id': slicer_id}
        request_id = slicer.APICall(LIVE_EVENT_GET_URL, params)
        HANDLECALL_REQUEST_METADATA[request_id] = {
            'kind': 'get_event_payload',
            'external_id': external_id,
            'slicer_id': slicer_id,
            'callback': callback,
        }
        log(f'[upl-py_LE] get_event_payload dispatched request_id={request_id} external_id={external_id}')
    except Exception as e:
        log(f'[upl-py_Err] get_event_payload: {e}' + traceback.format_exc())
        try:
            callback({'events': [], 'error': str(e)})
        except Exception as cb_e:
            log(f'[upl-py_Err] get_event_payload sync-fail callback: {cb_e}' + traceback.format_exc())


def start_event(external_id: str, slicer_id: str, callback: Callable,
                pts: int, pts_offset: int) -> None:
    """Async start of Live Event + immediate ContentStart. Failure sentinel: None."""
    global HANDLECALL_REQUEST_METADATA
    try:
        slicer.ContentStart(int(pts + pts_offset), f'{slicer_id} - {external_id}', external_id)
        log(f'[upl-py_Cs] start_event: ContentStart at {pts + pts_offset} pts external_id={external_id}')

        params = {'external_id': external_id, 'slicer_id': slicer_id}
        request_id = slicer.APICall(LIVE_EVENT_START_BY_EXTID_URL, params)
        HANDLECALL_REQUEST_METADATA[request_id] = {
            'kind': 'start_event',
            'external_id': external_id,
            'slicer_id': slicer_id,
            'callback': callback,
        }
        log(f'[upl-py_LE] start_event dispatched request_id={request_id} external_id={external_id}')
    except Exception as e:
        log(f'[upl-py_Err] start_event: {e}' + traceback.format_exc())
        try:
            callback(None)
        except Exception as cb_e:
            log(f'[upl-py_Err] start_event sync-fail callback: {cb_e}' + traceback.format_exc())


