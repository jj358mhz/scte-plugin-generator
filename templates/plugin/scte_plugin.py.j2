def _parse_bool_config(value, default=False):
    """Tolerant parser for boolean-shaped config values."""
    if isinstance(value, bool):
        return value
    if isinstance(value, int):
        return bool(value)
    if isinstance(value, str):
        v = value.strip().lower()
        if v in _TRUTHY:
            return True
        if v in _FALSY:
            return False
    return default


def _normalize_verbosity(raw, default='2'):
    """Normalize a raw scte_log_verbosity config value to '1', '2', or '3'."""
    v = str(raw).strip() if raw is not None else ''
    if v in ('1', '2', '3'):
        return v
    return default


# -----------------------------------------------------------------------------
# Duration extraction helpers
# -----------------------------------------------------------------------------

def break_dur(slice_info, index):
    """
    Extract segmentation_duration from a Type 6 descriptor at `index`.

    Returns 0 if the descriptor has no duration (e.g. END events). Value is
    in base48k uPTS units.

    Args:
        slice_info (dict): The SCTE bridge object.
        index (int): Position in the descriptors list.

    Returns:
        int: Duration in base48k uPTS, or 0 if absent.
    """
    try:
        descriptors = slice_info.get('descriptors', [])
        if index < 0 or index >= len(descriptors):
            return 0
        return int(descriptors[index].get('segmentation_duration', 0) or 0)
    except Exception as e:
        log(f'[upl-py_Err] break_dur({index}): {e}' + traceback.format_exc())
        return 0


def break_dur_oon(slice_info):
    """
    Extract duration from a Type 5 splice_insert command.

    Type 5 stores its duration on the `command` object rather than on a
    descriptor. Returns 0 for open-ended breaks (no duration_flag).

    Args:
        slice_info (dict): The SCTE bridge object.

    Returns:
        int: Duration in base48k uPTS, or 0 if absent.
    """
    try:
        command = slice_info.get('command', {})
        return int(command.get('duration', 0) or 0)
    except Exception as e:
        log(f'[upl-py_Err] break_dur_oon: {e}' + traceback.format_exc())
        return 0


def adis(duration, duration_offset):
    """
    Approximate Duration In Seconds — convert LiveSlicer base48k uPTS to seconds.

    Used everywhere for human-readable duration logging. Applies
    `duration_offset` from uplynk.conf before conversion. Returns 1 decimal
    place, matching CNBC/Fox/P1Media plugin convention.

    Args:
        duration (int): Base48k uPTS.
        duration_offset (int): Offset from dur_off_x() (may be negative).

    Returns:
        float: Approximate seconds, rounded to 1 decimal.
    """
    try:
        return round((duration + duration_offset) / 48000.0, 1)
    except Exception as e:
        log(f'[upl-py_Err] adis({duration}, {duration_offset}): {e}' + traceback.format_exc())
        return 0.0


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

def log(message, **kwargs):
    """
    Emit a structured log line via slicer.SlicerLogger.

    Verbosity gates SCTE_LOG_VERBOSITY:
        '1' — plugin message only
        '2' — + scte_message summary (default)
        '3' — + scte_message + slicer_metrics
    """
    global SLICER_STATUS_DICT, SCTE_LOG_VERBOSITY

    frame = inspect.currentframe()
    caller_func = '-'
    if frame is not None and frame.f_back is not None:
        caller_func = frame.f_back.f_code.co_name

    slicer_state = slicer.GetState()
    scte_message = '-'
    slicer_metrics = '-'

    if SCTE_LOG_VERBOSITY == '2':
        scte_message = SLICER_STATUS_DICT.get('scte_message', {}).get('repr', '-')
    elif SCTE_LOG_VERBOSITY == '3':
        scte_message = SLICER_STATUS_DICT.get('scte_message', {}).get('repr', '-')
        slicer_metrics = get_slicer_metrics()

    boundary_name = kwargs.get('boundary_name', '-')
    call_sign = kwargs.get('call_sign', '-')
    channel_group = SLICER_STATUS_DICT.get('channel_group', '-')
    command_type = kwargs.get('command_type', '-')
    oon = kwargs.get('oon', '-')
    segmentation_type_id = kwargs.get('segmentation_type_id', '-')
    slicer_id = SLICER_STATUS_DICT.get('slicer_id', '-')
    slicer_version = kwargs.get('slicer_version', '-')
    stream_type = kwargs.get('stream_type', '-')

    slicer.SlicerLogger(
        'INFO',
        f'[upl-py] host={HOST} pid={PROC_ID} caller={caller_func} '
        f'channel_group={channel_group} slicer_id={slicer_id} call_sign={call_sign} '
        f'stream_type={stream_type} plugin_version={PLUGIN_VERSION} command_type={command_type} '
        f'segmentation_type_id={segmentation_type_id} boundary_name={boundary_name} '
        f'oon={oon} slicer_state={slicer_state} slicer_version={slicer_version} '
        f'message={message} scte_message={scte_message} slicer_metrics={slicer_metrics}'
    )


def get_slicer_metrics(api_port=None):
    """Fetch slicer status for verbosity='3'. Never raises."""
    if api_port is None:
        api_port = get_api_port()
    try:
        response = requests.get(f'http://localhost:{api_port}/status', timeout=1.0)
        return str(response.json())
    except Exception as e:
        return f'- (metrics fetch failed: {e})'


