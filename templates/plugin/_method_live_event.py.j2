{# templates/plugin/_method_live_event.py.j2                                     #}
{# Disney lifecycle preset: Types 16/17/19/20/54/55                              #}
{#                                                                               #}
{# Assumes scte_plugin.py.j2 Section 4 provides:                                 #}
{#   - Async helpers: get_event_payload, start_event, terminal_event_end,        #}
{#     terminal_event_end_cancel, terminal_event_update                          #}
{#   - URL constants: LIVE_EVENT_STATE_URL, LIVE_EVENT_END_URL                   #}
{#   - Config helpers: pts_off_x, dur_off_x, break_dur, break_dur_terminal,      #}
{#     adis, live_event_end_ext, le_epoch_times, le_epoch_end_time, pt_mode,     #}
{#     id3_to_file_enable, id3_to_file, call_sign_id, get_api_port, slicer_ver,  #}
{#     stream_type_id                                                            #}
{#   - Globals: BREAK_UPID_MISMATCH, EXTERNAL_ID, LIVE_EVENT_DATA, LIVE_EVENT_ID,#}
{#     LIVE_EVENT_PAYLOAD, SLICER_ID_MISMATCH, TERMINAL_UPID, ZERO_DUR           #}
{#                                                                               #}
{# NOTE: Callbacks are inline per Disney pattern (closures over external_id,     #}
{# pts, pts_offset, id3_mode, call_sign). Module-level _type16_callback /        #}
{# _terminal_update_cb / _start_event_cb / _TYPE16_PTS_CACHE in scte_plugin.py.j2#}
{# are vestigial and can be removed.                                             #}

def {{ m.name }}(slice_info, slicer_id):
    channel_group = '{{ m.channel_group }}'
    call_sign = call_sign_id()
    api_port = get_api_port()
    slicer_version = slicer_ver()
    stream_type = stream_type_id()
    log(f'[upl-py_Param] From config file parameters - Call Sign set as: {call_sign} | Slicer Type set at the '
        f'start of the {channel_group} method as: {stream_type}', call_sign=call_sign,
        slicer_version=slicer_version, stream_type=stream_type)

    try:
        log(f'[upl-py_Method] In {channel_group} Method')
        global BREAK_UPID_MISMATCH, EXTERNAL_ID, HOST, ID3_ENABLE, ID3_FOLDER_PATH, LIVE_EVENT_DATA, \
            LIVE_EVENT_ID, LIVE_EVENT_PAYLOAD, LOCAL_MODE, OUTOFNETWORK_MODE, SLICER_CONFIG_DICT, \
            SLICER_ID_MISMATCH, TECH_ISSUES_EXTID, TERMINAL_UPID, ZERO_DUR

        id3_mode = id3_to_file_enable()
        log(f'[upl-py_Param] From config file parameter, ID3 mode set at start of {channel_group} '
            f'method as: <{id3_mode}>', call_sign=call_sign, slicer_version=slicer_version,
            stream_type=stream_type)

        passthrough_mode = pt_mode()
        log(f'[upl-py_Param] From config file parameter, Passthrough mode set at start of {channel_group} '
            f'method as: <{passthrough_mode}>', call_sign=call_sign, slicer_version=slicer_version,
            stream_type=stream_type)

        command_type = slice_info['splice_command_type']
        pts = slice_info['pts_time']  # already base48k uPTS

        # ══════════════════════════════════════════════════════════════════════
        # Command Type 6 — Time Signal (Program lifecycle + mid-event slates)
        # ══════════════════════════════════════════════════════════════════════
        if command_type == 6:
            seg_type_list = []
            seg_id_indices = []
            if 'descriptors' in slice_info:
                for i, descriptor in enumerate(slice_info['descriptors']):
                    if 'segmentation_type_id' in descriptor:
                        seg_type_list.append(descriptor['segmentation_type_id'])
                        seg_id_indices.append(i)

                # ──────────────────────────────────────────────────────────────
                # Type 0 (0x00) — Splice Null (log only)
                # ──────────────────────────────────────────────────────────────
                if 0 in seg_type_list:
                    log('From 0 (Splice-null), log only, take no action', command_type=command_type,
                        segmentation_type_id=0, call_sign=call_sign, slicer_version=slicer_version,
                        stream_type=stream_type)

                # ──────────────────────────────────────────────────────────────
                # Type 16 (0x10) — Program Start (Live Event Start)
                # ──────────────────────────────────────────────────────────────
                if 16 in seg_type_list:
                    idx = seg_type_list.index(16)
                    seg_id_idx = seg_id_indices[idx]
                    pts_offset = pts_off_x(16)
                    log(f'[upl-py_Off] From 16, pts_offset: {pts_offset}',
                        command_type=command_type, segmentation_type_id=16,
                        call_sign=call_sign, slicer_version=slicer_version, stream_type=stream_type)

                    # Reset state
                    EXTERNAL_ID.clear()
                    LIVE_EVENT_DATA.clear()
                    LIVE_EVENT_ID.clear()
                    LIVE_EVENT_PAYLOAD.clear()
                    SLICER_ID_MISMATCH = False
                    TERMINAL_UPID = False
                    ZERO_DUR = False

                    # Decode external_id (narrow exceptions)
                    try:
                        upid_bytes = slice_info['descriptors'][seg_id_idx]['segmentation_upid']
                        if not upid_bytes:
                            log('[upl-py_Err] Empty segmentation_upid — skipping', segmentation_type_id=16)
                            return
                        external_id = upid_bytes.decode('utf-8')
                        EXTERNAL_ID.append(external_id)
                    except (IndexError, KeyError, AttributeError, UnicodeDecodeError) as decode_err:
                        log(f'[upl-py_Err] Could not fetch or decode External ID: {decode_err}',
                            command_type=command_type, segmentation_type_id=16)
                        return

                    # Inline callback: closes over external_id, pts, pts_offset, id3_mode
                    def _type16_callback(event_payload, _raw_msg):
                        global SLICER_ID_MISMATCH

                        # 1) Conflict check
                        for ev in event_payload.get('events', []):
                            for conflict in ev.get('conflicts', []):
                                sid = conflict.get('slicer_id')
                                if sid and sid != slicer_id:
                                    SLICER_ID_MISMATCH = True
                                    log(f'[upl-py_Err] Slicer ID mismatch: expected {slicer_id}, got {sid}',
                                        segmentation_type_id=16, call_sign=call_sign)

                        # 2) Bail on mismatch
                        if SLICER_ID_MISMATCH:
                            log(f'[upl-py_Err] Type-16 mismatch — skipping start for {external_id}',
                                segmentation_type_id=16, call_sign=call_sign)
                            return

                        # 3) Compute epoch and start
                        start_time_epoch = int(time.time() * 1000) + 1000

                        def terminal_update(ext_id, _):
                            try:
                                log(f'[upl-py_LE] From 16, terminal update for <{ext_id}>',
                                    command_type=command_type, segmentation_type_id=16,
                                    call_sign=call_sign, slicer_version=slicer_version,
                                    stream_type=stream_type)
                            except (TypeError, KeyError) as err:
                                log(f'[upl-py_Err] terminal_update log failed: {err}',
                                    command_type=command_type, segmentation_type_id=16)

                        def start_event_cb(event_id, _):
                            try:
                                state = slicer.GetState()
                            except RuntimeError as state_err:
                                log(f'[upl-py_Err] Could not get slicer state: {state_err}',
                                    command_type=command_type, segmentation_type_id=16,
                                    call_sign=call_sign, slicer_id=slicer_id,
                                    slicer_version=slicer_version, stream_type=stream_type)
                                return None

                            if state != 'slicing':
                                log(f'[upl-py_LE] From 16, forcing ContentStart for <{event_id}>',
                                    command_type=command_type, segmentation_type_id=16,
                                    call_sign=call_sign, slicer_id=slicer_id,
                                    slicer_version=slicer_version, stream_type=stream_type)
                                try:
                                    slicer.ContentStart(int(pts + pts_offset))
                                    slicer.FlushBreakMeta(int(pts + pts_offset))
                                except (OSError, IOError) as io_err:
                                    log(f'[upl-py_Err] ContentStart/FlushBreakMeta failed: {io_err}',
                                        command_type=command_type, segmentation_type_id=16)
                                return None

                            log(f'[upl-py_LE] From 16, already slicing for <{event_id}>',
                                command_type=command_type, segmentation_type_id=16)
                            return event_id

                        # Fire the updates
                        terminal_event_update(external_id, start_time_epoch, terminal_update)
                        start_event(external_id, slicer_id, start_event_cb, pts, pts_offset)

                        # 4) Write ID3 if enabled
                        if id3_mode:
                            id3_to_file(api_port, call_sign, external_id, 'PROGRAM')
                            log(f'[upl-py_ID3] Wrote ID3 payload for <{external_id}>',
                                segmentation_type_id=16, call_sign=call_sign)

                    # Register callback and return immediately
                    get_event_payload(external_id, slicer_id, _type16_callback)
                    return

                # ──────────────────────────────────────────────────────────────
                # Type 17 (0x11) — Program End (Live Event End)
                # ──────────────────────────────────────────────────────────────
                if 17 in seg_type_list:
                    pts_offset = pts_off_x(17)
                    log(f'[upl-py_Off] From 17, pts_offset set as: {pts_offset} pts',
                        command_type=command_type, segmentation_type_id=17, call_sign=call_sign,
                        slicer_version=slicer_version, stream_type=stream_type)

                    try:
                        ExternalID = EXTERNAL_ID[-1]
                        log(f'[upl-py_LE] From 17, ExternalID lookup from list is: {ExternalID}',
                            command_type=command_type, segmentation_type_id=17, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                    except IndexError:
                        log(f'[upl-py_Err] From 17, EXTERNAL_ID list is empty — no prior Type 16, skipping',
                            command_type=command_type, segmentation_type_id=17, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        return
                    except Exception as error:
                        log(f'[upl-py_Err] From 17, Could not fetch ExternalID: {error}\n{traceback.format_exc()}',
                            command_type=command_type, segmentation_type_id=17, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        return

                    # None sentinel set by start_event when API failed to return event_id
                    live_event_id = LIVE_EVENT_ID.get(ExternalID)
                    if not live_event_id:
                        log(f'[upl-py_Err] From 17, no valid Live Event ID for <{ExternalID}> — '
                            f'Type 16 start may have failed, skipping',
                            command_type=command_type, segmentation_type_id=17, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        return
                    assert isinstance(live_event_id, str)  # narrows type for PyCharm; guard above proves it
                    log(f'[upl-py_LE] From 17, ExternalID is: <{ExternalID}> | Live event ID is: '
                        f'<{live_event_id}>', slicer_version=slicer_version, stream_type=stream_type)

                    try:
                        # End ad break before ending the event
                        if slicer.GetState() == 'adbreak':
                            pts_offset = pts_off_x(17)
                            log(f'[upl-py_Off] From 17, pts_offset set as: {pts_offset} pts | '
                                f'Affiliate Pod End at {pts + pts_offset} pts', command_type=command_type,
                                segmentation_type_id=17, call_sign=call_sign, stream_type=stream_type)
                            slicer.FlushBreakMeta(int(pts + pts_offset))
                            slicer.AdEnd(int(pts + pts_offset))
                        else:
                            log(f'[upl-py_Ad] From 17, slicer not in ad break state, ending the event '
                                f'normally', command_type=command_type, segmentation_type_id=17,
                                call_sign=call_sign, stream_type=stream_type)
                    except Exception as error:
                        log(f'[upl-py_Err] From 17, Error ending ad break: {error}',
                            command_type=command_type, segmentation_type_id=17, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        return

                    try:
                        end_extension = live_event_end_ext()
                        end_time_epoch = le_epoch_times(end_extension)

                        event_end_dict = {
                            'state': 'Blackout',
                            'id': live_event_id,
                            'new_beam': True
                        }
                        event_json_payload = json.dumps(event_end_dict)
                        log(f'[upl-py_LE] From 17, event_json_payload is: {event_json_payload}',
                            command_type=command_type, segmentation_type_id=17, call_sign=call_sign,
                            slicer_id=slicer_id, slicer_version=slicer_version, stream_type=stream_type)

                        log(f'[upl-py_LE] From 17, Ending Live Event <{live_event_id}> | end time '
                            f'extension is: <{end_extension}> | end time epoch is: <{end_time_epoch}> | '
                            f'placing the slicer into blackout at: {pts + pts_offset} pts.',
                            command_type=command_type, segmentation_type_id=17, call_sign=call_sign,
                            slicer_id=slicer_id, slicer_version=slicer_version, stream_type=stream_type)
                        slicer.APICall(LIVE_EVENT_END_URL, event_json_payload)
                        slicer.Blackout(int(pts + pts_offset))
                    except Exception as error:
                        log(f'[upl-py_Err] From 17, Could not end event: {live_event_id} | {error}',
                            command_type=command_type, segmentation_type_id=17, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)

                # ──────────────────────────────────────────────────────────────
                # Type 19 (0x13) — Program Breakaway (mid-event slate start)
                # ──────────────────────────────────────────────────────────────
                if 19 in seg_type_list:
                    index = seg_type_list.index(19)
                    seg_id_index = seg_id_indices[index]
                    pts_offset_19 = pts_off_x(19)
                    log(f'[upl-py_Off] From 19, pts_offset set as: {pts_offset_19} pts',
                        command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                        slicer_version=slicer_version, stream_type=stream_type)

                    try:
                        scte_slate_type_bytes = slice_info['descriptors'][seg_id_index]['segmentation_upid']
                        scte_slate_type = scte_slate_type_bytes.decode('utf-8')
                    except (IndexError, KeyError, AttributeError, UnicodeDecodeError) as decode_err:
                        log(f'[upl-py_Err] From 19, Could not decode SCTE slate type UPID: {decode_err}\n'
                            f'{traceback.format_exc()}',
                            command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        return

                    try:
                        ExternalID = EXTERNAL_ID[-1]
                    except IndexError:
                        log(f'[upl-py_Err] From 19, EXTERNAL_ID list is empty — no prior Type 16, skipping',
                            command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        return

                    # None sentinel set by start_event when API failed to return event_id
                    live_event_id = LIVE_EVENT_ID.get(ExternalID)
                    if not live_event_id:
                        log(f'[upl-py_Err] From 19, no valid Live Event ID for <{ExternalID}> — '
                            f'Type 16 start may have failed, skipping',
                            command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        return
                    assert isinstance(live_event_id, str)  # narrows type for PyCharm; guard above proves it
                    log(f'[upl-py_LE] From 19, ExternalID is: <{ExternalID}> | Live event ID is: '
                        f'<{live_event_id}>', command_type=command_type, segmentation_type_id=19,
                        call_sign=call_sign, slicer_version=slicer_version, stream_type=stream_type)

                    # Initialize slate GUIDs to None to avoid reference-before-assignment
                    halftime_slate_guid = None
                    techdiff_slate_guid = None
                    terminal_slate_guid = None
                    weather_slate_guid = None

                    try:
                        log(f'[upl-py_Slate] From 19, Live event payload dictionary is: <{LIVE_EVENT_PAYLOAD}>',
                            command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)

                        # Post-hardening shape: dict with 'events' key holding list of event dicts.
                        # Guard against legacy bare-list shape too.
                        payload_entry = LIVE_EVENT_PAYLOAD.get(ExternalID) if isinstance(LIVE_EVENT_PAYLOAD,
                                                                                         dict) else None
                        events_list = None
                        if isinstance(payload_entry, dict):
                            events_list = payload_entry.get('events')
                        elif isinstance(payload_entry, list):
                            events_list = payload_entry

                        if events_list and isinstance(events_list, list) and isinstance(events_list[0], dict):
                            first_event = events_list[0]
                            meta = first_event.get('meta', {}) or {}
                            halftime_slate_guid = meta.get('slate_halftime')
                            techdiff_slate_guid = meta.get('slate_techdiff')
                            weather_slate_guid = meta.get('slate_weather')
                            terminal_slate_guid = first_event.get('post_slate')

                            log(f'[upl-py_Slate] From 19, Extracted slate GUIDs — '
                                f'halftime: <{halftime_slate_guid or "None"}> | '
                                f'techdiff: <{techdiff_slate_guid or "None"}> | '
                                f'terminal: <{terminal_slate_guid or "None"}> | '
                                f'weather: <{weather_slate_guid or "None"}>',
                                command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)
                        else:
                            log(f'[upl-py_Err] From 19, LIVE_EVENT_PAYLOAD for <{ExternalID}> has unexpected '
                                f'shape, no slate GUIDs extracted',
                                command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)

                    except Exception as error:
                        log(f'[upl-py_Err] From 19, Could not gather slate GUIDs: {error}\n'
                            f'{traceback.format_exc()}',
                            command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        return

                    # Map SCTE slate type to the corresponding GUID
                    slate_guid_map = {
                        'slate:halftime': halftime_slate_guid,
                        'slate:techdiff': techdiff_slate_guid,
                        'slate:terminal': terminal_slate_guid,
                        'slate:weather': weather_slate_guid,
                    }
                    if scte_slate_type not in slate_guid_map:
                        log(f'[upl-py_Err] From 19, Unrecognized slate type: {scte_slate_type}, skipping',
                            command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        return
                    scte_slate_guid = slate_guid_map[scte_slate_type]

                    # Guard against firing the API with a None GUID
                    if not scte_slate_guid:
                        log(f'[upl-py_Err] From 19, No GUID found for slate type <{scte_slate_type}> in event '
                            f'payload, skipping slate insertion',
                            command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        return
                    assert isinstance(scte_slate_guid, str)  # narrows type for PyCharm; guard above proves it

                    try:
                        slate_data_dict = {
                            'slate_id': scte_slate_guid,
                            'id': live_event_id
                        }
                        slate_json_payload = json.dumps(slate_data_dict)
                        log(f'[upl-py_Slate] From 19, slate_json_payload is: {slate_json_payload}',
                            command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                            slicer_id=slicer_id, slicer_version=slicer_version, stream_type=stream_type)

                        log(f'[upl-py_Slate] From 19, SCTE slate UPID: <{scte_slate_type}> | slate GUID: '
                            f'<{scte_slate_guid}> start at {pts + pts_offset_19} pts',
                            command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        slicer.Blackout(int(pts + pts_offset_19))
                        slicer.APICall(LIVE_EVENT_STATE_URL, slate_json_payload)
                    except Exception as error:
                        log(f'[upl-py_Err] From 19, Could not trigger SCTE slate — UPID: <{scte_slate_type}>, '
                            f'GUID: <{scte_slate_guid}>: {error}\n{traceback.format_exc()}',
                            command_type=command_type, segmentation_type_id=19, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)

                # ──────────────────────────────────────────────────────────────
                # Type 20 (0x14) — Program Resumption (mid-event slate end)
                # ──────────────────────────────────────────────────────────────
                if 20 in seg_type_list:
                    pts_offset_20 = pts_off_x(20)
                    log(f'[upl-py_Off] From 20, pts_offset set as: {pts_offset_20} pts',
                        command_type=command_type, segmentation_type_id=20, call_sign=call_sign,
                        slicer_version=slicer_version, stream_type=stream_type)

                    try:
                        ExternalID = EXTERNAL_ID[-1]
                        log(f'[upl-py_LE] From 20, ExternalID lookup from list is: <{ExternalID}>',
                            command_type=command_type, segmentation_type_id=20, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                    except IndexError:
                        log(f'[upl-py_Err] From 20, EXTERNAL_ID list is empty — no prior Type 16, skipping',
                            command_type=command_type, segmentation_type_id=20, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        return

                    # None sentinel set by start_event when API failed to return event_id
                    live_event_id = LIVE_EVENT_ID.get(ExternalID)
                    if not live_event_id:
                        log(f'[upl-py_Err] From 20, no valid Live Event ID for <{ExternalID}> — '
                            f'Type 16 start may have failed, skipping',
                            command_type=command_type, segmentation_type_id=20, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        return
                    assert isinstance(live_event_id, str)  # narrows type for PyCharm; guard above proves it
                    log(f'[upl-py_Slate] From 20, ExternalID is: <{ExternalID}> | Live event ID is: '
                        f'<{live_event_id}>', command_type=command_type, segmentation_type_id=20,
                        call_sign=call_sign, slicer_version=slicer_version, stream_type=stream_type)

                    try:
                        content_data_dict = {
                            'state': 'Slicer',
                            'id': live_event_id,
                            'new_beam': True
                        }
                        content_json_payload = json.dumps(content_data_dict)
                        log(f'[upl-py_Slate] From 20, content_json_payload is: {content_json_payload}',
                            command_type=command_type, segmentation_type_id=20, call_sign=call_sign,
                            slicer_id=slicer_id, slicer_version=slicer_version, stream_type=stream_type)

                        log(f'[upl-py_Slate] From 20, Content Start at {pts + pts_offset_20} pts for '
                            f'Live Event ID: <{live_event_id}>', command_type=command_type,
                            segmentation_type_id=20, call_sign=call_sign, slicer_version=slicer_version,
                            stream_type=stream_type)
                        slicer.APICall(LIVE_EVENT_STATE_URL, content_json_payload)
                        slicer.ContentStart(int(pts + pts_offset_20))
                    except Exception as error:
                        log(f'[upl-py_Err] From 20, Could not resume content for Live Event <{live_event_id}>: '
                            f'{error}\n{traceback.format_exc()}',
                            command_type=command_type, segmentation_type_id=20, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)

            else:
                log('[upl-py_Err] Warning: There are no descriptors in command type 6',
                    command_type=command_type, slicer_version=slicer_version, stream_type=stream_type)

                # ══════════════════════════════════════════════════════════════════════
        # Command Type 5 — Splice Insert (Ad breaks: Types 54/55)
        # ══════════════════════════════════════════════════════════════════════
        elif command_type == 5:
            seg_type_list = []
            seg_id_indices = []
            if 'descriptors' in slice_info:
                for i, descriptor in enumerate(slice_info['descriptors']):
                    if 'segmentation_type_id' in descriptor:
                        seg_type_list.append(descriptor['segmentation_type_id'])
                        seg_id_indices.append(i)

                if passthrough_mode:
                    log(f'[upl-py_Mode] Passthrough mode set to {passthrough_mode}, skip processing all '
                        f'ad breaks', command_type=command_type, call_sign=call_sign,
                        slicer_version=slicer_version, stream_type=stream_type)
                else:
                    # ──────────────────────────────────────────────────────────
                    # Type 54 (0x36) — Distributor Placement Opportunity Start
                    # ──────────────────────────────────────────────────────────
                    if 54 in seg_type_list:
                        index = seg_type_list.index(54)
                        seg_id_index = seg_id_indices[index]
                        base64_54 = slice_info['base64']
                        duration = break_dur(slice_info, index)
                        zero_dur = slice_info['descriptors'][index]['segmentation_duration']

                        # Reset per-break flags
                        BREAK_UPID_MISMATCH = False
                        ZERO_DUR = False
                        log(f'[upl-py_LE] From 54, resetting per-break flags — BREAK_UPID_MISMATCH: '
                            f'<{BREAK_UPID_MISMATCH}> | ZERO_DUR: <{ZERO_DUR}>',
                            command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)

                        # Decode SCTE UPID
                        try:
                            scte_upid_bytes = slice_info['descriptors'][seg_id_index]['segmentation_upid']
                            scte_upid = scte_upid_bytes.decode('utf-8')
                        except (IndexError, KeyError, AttributeError, UnicodeDecodeError) as decode_err:
                            log(f'[upl-py_Err] From 54, Could not decode break UPID: {decode_err}\n'
                                f'{traceback.format_exc()}',
                                command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)
                            return

                        # Fetch ExternalID
                        try:
                            ExternalID = EXTERNAL_ID[-1]
                        except IndexError:
                            log(f'[upl-py_Err] From 54, EXTERNAL_ID list is empty — no prior Type 16, skipping',
                                command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)
                            return

                        # Classify the UPID
                        if scte_upid == 'slate:terminal':
                            TERMINAL_UPID = True
                            BREAK_UPID_MISMATCH = False  # force no mismatch for terminal slates
                            log(f'[upl-py_LE] From 54, SCTE UPID set to: <{scte_upid}>, setting the '
                                f'TERMINAL_UPID to: <{TERMINAL_UPID}> | BREAK_UPID_MISMATCH to: '
                                f'<{BREAK_UPID_MISMATCH}>', command_type=command_type,
                                segmentation_type_id=54, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)

                        elif scte_upid != ExternalID:
                            BREAK_UPID_MISMATCH = True
                            log(f'[upl-py_LE] From 54, SCTE UPID: <{scte_upid}> != the External ID: '
                                f'<{ExternalID}>, setting BREAK_UPID_MISMATCH to: <{BREAK_UPID_MISMATCH}>',
                                command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)
                        else:
                            BREAK_UPID_MISMATCH = False
                            log(f'[upl-py_LE] From 54, SCTE UPID: <{scte_upid}> == the External ID: '
                                f'<{ExternalID}>, setting BREAK_UPID_MISMATCH to: <{BREAK_UPID_MISMATCH}>',
                                command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)

                        # Guard: zero duration (skip whole 54/55 pair)
                        if zero_dur == 0:
                            ZERO_DUR = True
                            log(f'[upl-py_Err] From 54, setting ZERO_DUR to True — invalid duration: '
                                f'{zero_dur} pts, skipping ad break',
                                command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)
                            return

                        # Guard: UPID mismatch (skip whole 54/55 pair)
                        if BREAK_UPID_MISMATCH:
                            log(f'[upl-py_LE] From 54, BREAK_UPID_MISMATCH is: <{BREAK_UPID_MISMATCH}> — '
                                f'invalid match between SCTE break UPID: <{scte_upid}> and the '
                                f'external ID: <{ExternalID}>, skipping ad break',
                                command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)
                            return

                        # Start the ad
                        duration_offset_54 = dur_off_x(54)
                        pts_offset_54 = pts_off_x(54)
                        approx_duration_in_seconds = adis(duration, duration_offset_54)
                        log(f'[upl-py_Off] From 54, duration_offset: {duration_offset_54} pts | '
                            f'pts_offset: {pts_offset_54} pts',
                            command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        log(f'[upl-py_Ad] From 54, Ad Start at {pts + pts_offset_54} pts for '
                            f'{approx_duration_in_seconds} seconds',
                            command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                            slicer_version=slicer_version, stream_type=stream_type)
                        slicer.AdMeta('base64_54', str(base64_54, 'utf-8'))
                        slicer.AdStart(int(pts + pts_offset_54), int(duration + duration_offset_54))

                        # Terminal Break Event End Handling
                        if TERMINAL_UPID:
                            # None sentinel set by start_event when API failed to return event_id
                            live_event_id = LIVE_EVENT_ID.get(ExternalID)
                            if not live_event_id:
                                log(f'[upl-py_Err] From 54, Terminal Ending, no valid Live Event ID for '
                                    f'<{ExternalID}> — Type 16 start may have failed, skipping terminal end',
                                    command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                                    slicer_version=slicer_version, stream_type=stream_type)
                                TERMINAL_UPID = False
                                return
                            assert isinstance(live_event_id, str)
                            log(f'[upl-py_LE] From 54, Terminal Ending, Live event ID: <{live_event_id}>',
                                command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)

                            try:
                                terminal_duration = break_dur_terminal(slice_info, seg_id_index)
                                end_extension = live_event_end_ext()
                                end_time_epoch = le_epoch_end_time(terminal_duration, end_extension)
                            except Exception as error:
                                log(f'[upl-py_Err] From 54, Terminal Ending, could not compute end time epoch: '
                                    f'{error}\n{traceback.format_exc()}',
                                    command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                                    slicer_version=slicer_version, stream_type=stream_type)
                                TERMINAL_UPID = False
                                return

                            # Inline callback: closes over command_type, call_sign, slicer_id, etc.
                            def _terminal_event_end(event_id, _event_json):
                                log(f'[upl-py_LE] From 54 callback, Terminal Ending of Live Event: <{event_id}>',
                                    command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                                    slicer_id=slicer_id, slicer_version=slicer_version,
                                    stream_type=stream_type)
                                return event_id

                            try:
                                terminal_event_end(live_event_id, end_time_epoch, _terminal_event_end)
                            except Exception as error:
                                log(f'[upl-py_Err] From 54, Could not schedule terminal event end for '
                                    f'<{live_event_id}>: {error}\n{traceback.format_exc()}',
                                    command_type=command_type, segmentation_type_id=54, call_sign=call_sign,
                                    slicer_version=slicer_version, stream_type=stream_type)
                                TERMINAL_UPID = False
                                return

                    # ──────────────────────────────────────────────────────────
                    # Type 55 (0x37) — Distributor Placement Opportunity End
                    # ──────────────────────────────────────────────────────────
                    if 55 in seg_type_list:
                        index = seg_type_list.index(55)
                        seg_id_index = seg_id_indices[index]

                        # Decode SCTE UPID
                        try:
                            scte_upid_bytes = slice_info['descriptors'][seg_id_index]['segmentation_upid']
                            scte_upid = scte_upid_bytes.decode('utf-8')
                        except (IndexError, KeyError, AttributeError, UnicodeDecodeError) as decode_err:
                            log(f'[upl-py_Err] From 55, Could not decode break UPID: {decode_err}\n'
                                f'{traceback.format_exc()}',
                                command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)
                            return

                        # Fetch ExternalID
                        try:
                            ExternalID = EXTERNAL_ID[-1]
                        except IndexError:
                            log(f'[upl-py_Err] From 55, EXTERNAL_ID list is empty — no prior Type 16, skipping',
                                command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)
                            return

                        # ── Terminal slate branch ────────────────────────────
                        if scte_upid == 'slate:terminal':
                            TERMINAL_UPID = True
                            BREAK_UPID_MISMATCH = False
                            log(f'[upl-py_LE] From 55, SCTE UPID set to <{scte_upid}>. Ending the ad break and '
                                f'triggering event_end_cancel. TERMINAL_UPID: <{TERMINAL_UPID}> | '
                                f'BREAK_UPID_MISMATCH: <{BREAK_UPID_MISMATCH}>',
                                command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)

                            # None sentinel set by start_event when API failed to return event_id
                            live_event_id = LIVE_EVENT_ID.get(ExternalID)
                            if not live_event_id:
                                log(f'[upl-py_Err] From 55, Terminal Ending, no valid Live Event ID for '
                                    f'<{ExternalID}> — Type 16 start may have failed, skipping ad end and '
                                    f'cancel',
                                    command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                    slicer_version=slicer_version, stream_type=stream_type)
                                TERMINAL_UPID = False
                                return
                            assert isinstance(live_event_id, str)
                            log(f'[upl-py_LE] From 55, Terminal Ending, Live event ID: <{live_event_id}>',
                                command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)

                            # End the ad break
                            pts_offset_55 = pts_off_x(55)
                            log(f'[upl-py_Ad] From 55, Ad End at {pts + pts_offset_55} pts',
                                command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)
                            slicer.AdEnd(int(pts + pts_offset_55))

                            # Inline callback: closes over command_type, call_sign, slicer_version, stream_type
                            def _terminal_event_end_cancel(event_id, _event_json):
                                log(f'[upl-py_LE] From 55 callback, event_end_cancel triggered for '
                                    f'Live Event: <{event_id}>',
                                    command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                    slicer_version=slicer_version, stream_type=stream_type)
                                return event_id

                            try:
                                terminal_event_end_cancel(live_event_id, _terminal_event_end_cancel)
                            except Exception as error:
                                log(f'[upl-py_Err] From 55, Could not cancel terminal event end for '
                                    f'<{live_event_id}>: {error}\n{traceback.format_exc()}',
                                    command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                    slicer_version=slicer_version, stream_type=stream_type)
                                TERMINAL_UPID = False
                                return

                            TERMINAL_UPID = False  # reset for next event (successful path)

                        # ── Non-terminal branch ──────────────────────────────
                        else:
                            # Classify the UPID
                            if scte_upid != ExternalID:
                                BREAK_UPID_MISMATCH = True
                                log(f'[upl-py_LE] From 55, SCTE UPID: <{scte_upid}> != the External ID: '
                                    f'<{ExternalID}>, setting BREAK_UPID_MISMATCH to: <{BREAK_UPID_MISMATCH}>',
                                    command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                    slicer_version=slicer_version, stream_type=stream_type)
                            else:
                                BREAK_UPID_MISMATCH = False
                                log(f'[upl-py_LE] From 55, SCTE UPID: <{scte_upid}> == the External ID: '
                                    f'<{ExternalID}>, setting BREAK_UPID_MISMATCH to: <{BREAK_UPID_MISMATCH}>',
                                    command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                    slicer_version=slicer_version, stream_type=stream_type)

                            # Guard: zero duration from Type 54 (skip AdEnd)
                            if ZERO_DUR:
                                log('[upl-py_Err] From 55, prior Type 54 had zero duration, skipping AdEnd',
                                    command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                    slicer_version=slicer_version, stream_type=stream_type)
                                ZERO_DUR = False
                                return

                            # Guard: UPID mismatch (skip AdEnd)
                            if BREAK_UPID_MISMATCH:
                                log('[upl-py_Err] From 55, invalid match between SCTE break UPID and the '
                                    'external ID, skipping AdEnd',
                                    command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                    slicer_version=slicer_version, stream_type=stream_type)
                                BREAK_UPID_MISMATCH = False
                                return

                            # Fire AdEnd
                            pts_offset_55 = pts_off_x(55)
                            log(f'[upl-py_Off] From 55, pts_offset set as: {pts_offset_55} pts',
                                command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)
                            log(f'[upl-py_Ad] From 55, Ad End at {pts + pts_offset_55} pts',
                                command_type=command_type, segmentation_type_id=55, call_sign=call_sign,
                                slicer_version=slicer_version, stream_type=stream_type)
                            slicer.AdEnd(int(pts + pts_offset_55))

            else:
                log('[upl-py_Err] Warning: There are no descriptors in command type 5',
                    command_type=command_type, slicer_version=slicer_version, stream_type=stream_type)

        else:
            log('[upl-py_Err] Unhandled SCTE command type', command_type=command_type,
                slicer_version=slicer_version, stream_type=stream_type)

    except Exception as e:
        log(f'[upl-py_Err] Exception in Plugin method {channel_group}: {e}' + traceback.format_exc())
